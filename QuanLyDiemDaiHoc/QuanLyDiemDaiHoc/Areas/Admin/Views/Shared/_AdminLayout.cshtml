<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduScore Admin</title>
    <!-- Google Fonts - Font chữ hiện đại -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CDN (Đã sửa đúng chuẩn) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- FontAwesome 6 CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <!-- Chart.js CDN (Cho biểu đồ) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- CSS Tùy chỉnh (Định nghĩa màu sắc & khoảng cách) -->
    <link rel="stylesheet" href="~/css/admin-style.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        @await Component.InvokeAsync("AdminSidebar")
        
        <!-- Page Content Wrapper -->
        <div id="page-content-wrapper">
            <!-- Top Navigation Bar -->
            @await Component.InvokeAsync("AdminTopbar")
            
            <!-- Main Content -->
            <div class="container-fluid px-4 main-content">
                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>