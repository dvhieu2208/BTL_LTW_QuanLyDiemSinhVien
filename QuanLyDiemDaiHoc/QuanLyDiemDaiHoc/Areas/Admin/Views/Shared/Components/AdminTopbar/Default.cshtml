@{
    var tenDangNhap = Context.Session.GetString("TenDangNhap") ?? "admin";
    var title = ViewData["Title"]?.ToString() ?? "Tổng quan";
}
<header class="app-topbar">
    <button type="button" class="topbar-toggle" data-sidebar-toggle aria-controls="appSidebar" aria-expanded="true" aria-label="Thu gọn / mở rộng menu">
        <i class="fas fa-bars" aria-hidden="true"></i>
    </button>

    <div class="topbar-title">
        <div class="topbar-crumb">
            <span>Quản trị</span><i class="fas fa-chevron-right" aria-hidden="true"></i><span>Hệ thống quản lý điểm</span>
        </div>
        <div class="topbar-heading">@title</div>
    </div>

    <div class="topbar-actions">
        <div class="topbar-chip d-none d-lg-flex">
            <i class="far fa-calendar" aria-hidden="true"></i>
            <span data-today>@DateTime.Now.ToString("dd/MM/yyyy")</span>
        </div>

        <div class="topbar-user">
            <span class="avatar">@(tenDangNhap.Length > 0 ? tenDangNhap.Substring(0, 1) : "A")</span>
            <div class="user-meta">
                <div class="user-name">@tenDangNhap</div>
                <div class="user-role">Quản trị viên</div>
            </div>
        </div>

        <form asp-area="" asp-controller="Account" asp-action="Logout" method="get" class="m-0" data-no-loading>
            <button type="submit" class="btn btn-soft-danger btn-sm" title="Đăng xuất" data-tooltip>
                <i class="fas fa-sign-out-alt" aria-hidden="true"></i><span class="btn-logout-text">Đăng xuất</span>
            </button>
        </form>
    </div>
</header>
