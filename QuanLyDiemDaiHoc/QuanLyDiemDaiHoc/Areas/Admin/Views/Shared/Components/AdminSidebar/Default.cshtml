@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<div class="bg-dark-blue border-right sidebar d-flex flex-column" id="sidebar-wrapper">
    <div class="sidebar-heading p-4 text-white">

        <div class="d-flex align-items-center mb-1">
            <div class="logo-box bg-white text-dark-blue d-flex align-items-center justify-content-center fw-bold me-2" style="width: 40px; height: 40px; border-radius: 8px;">
                ES
            </div>
            <div class="logo-text">
                <span class="fw-bold fs-5 text-white">EduScore</span><br/>
                <span class="fs-7 text-uppercase text-white-50">University Portal</span>
            </div>
        </div>
    </div>
    
    <div class="list-group list-group-flush px-2 flex-grow-1">
        <p class="text-uppercase text-white-50 fs-8 px-3 mt-2 mb-2" style="font-size: 0.75rem;">Không gian làm việc</p>
        
        <a asp-area="Admin" asp-controller="Home" asp-action="Index" 
           class="list-group-item list-group-item-action bg-transparent text-white border-0 py-2.5 mb-1 rounded-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
           <i class="fas fa-th-large me-3"></i>Tổng quan
        </a>
        
        <a asp-area="Admin" asp-controller="SinhVien" asp-action="Index" 
   class="list-group-item list-group-item-action bg-transparent text-white border-0 py-2.5 mb-1 rounded-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "SinhVien" ? "active" : "")">
    <i class="fas fa-user-graduate me-3"></i>Sinh viên
        </a>
        <a asp-area="Admin" asp-controller="Khoalop" asp-action="Index"
           class="list-group-item list-group-item-action bg-transparent text-white border-0 py-2.5 mb-1 rounded-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Khoalop" ? "active" : "")">
            <i class="fas fa-university me-3"></i>Khoa & Lớp
        </a>

        <a asp-area="Admin" asp-controller="MonHoc" asp-action="Index"
           class="list-group-item list-group-item-action bg-transparent text-white border-0 py-2.5 mb-1 rounded-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "MonHoc" ? "active" : "")">
            <i class="fas fa-book me-3"></i>Môn học
        </a>

        <a asp-area="Admin" asp-controller="PhongHoc" asp-action="Index"
           class="list-group-item list-group-item-action bg-transparent text-white border-0 py-2.5 mb-1 rounded-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "PhongHoc" ? "active" : "")">
            <i class="fas fa-door-open me-3"></i>Phòng học
        </a>

        <a asp-area ="Admin" asp-controller ="ThoiKhoaBieu" asp-action ="Index"
            class="list-group-item list-group-item-action bg-transparent text-white border-0 py-2.5 mb-1 rounded-3">
            <i class="fas fa-calendar-alt me-3"></i>Thời khóa biểu
        </a>

        <a asp-area="Admin" asp-controller="Diem" asp-action="Index" 
           class="list-group-item list-group-item-action bg-transparent text-white border-0 py-2.5 mb-1 rounded-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Diem" ? "active" : "")">
           <i class="fas fa-clipboard-check me-3"></i>Quản lý điểm
        </a>

        <a asp-area="Admin" asp-controller ="TaiKhoan" asp-action="Index"
            class="list-group-item list-group-item-action bg-transparent text-white border-0 py-2.5 mt-auto rounded-3">
           <i class="fas fa-user-circle me-3"></i>Tài khoản
        </a>
    </div>

    <!-- Thông tin người dùng ở góc dưới sidebar -->
    <div class="sidebar-footer p-3 border-top border-secondary text-white mt-auto">
        <div class="d-flex align-items-center">
            <div class="avatar bg-white text-primary d-flex align-items-center justify-content-center fw-bold me-2 rounded-circle" style="width: 38px; height: 38px;">
                HT
            </div>
            <div>
                <div class="fw-bold fs-7">Quản trị hệ thống</div>
                <div class="fs-8 text-white-50">Phòng đào tạo</div>
            </div>
        </div>
    </div>
</div>