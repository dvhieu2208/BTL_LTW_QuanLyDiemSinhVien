@model List<QuanLyDiemDaiHoc.Areas.Admin.Controllers.DiemModelItem>
@{
    ViewData["Title"] = "Quản lý điểm sinh viên";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4">
    <h2 class="mt-4 fw-bold">QUẢN LÝ VÀ NHẬP ĐIỂM SINH VIÊN</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-1"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-triangle me-1"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Form Bộ Lọc Lớp & Môn học -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form method="get" asp-area="Admin" asp-controller="Diem" asp-action="Index" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Chọn Lớp học</label>
                    <select name="maLop" class="form-select" asp-items="ViewBag.MaLop">
                        <option value="">-- Chọn Lớp --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Chọn Môn học</label>
                    <select name="maMon" class="form-select" asp-items="ViewBag.MaMon">
                        <option value="">-- Chọn Môn --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">Học kỳ</label>
                    <input type="number" name="hocKy" class="form-control" value="@ViewBag.SelectedHocKy" min="1" max="10" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search me-1"></i> Lọc danh sách
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng Nhập Điểm Hàng Loạt -->
    @if (Model != null && Model.Count > 0)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="m-0 fw-bold text-primary">Danh Sách Sinh Viên (@Model.Count)</h5>
            </div>
            <div class="card-body">
                <form method="post" asp-area="Admin" asp-controller="Diem" asp-action="SaveGrades">
                    <input type="hidden" name="maLop" value="@ViewBag.SelectedMaLop" />
                    <input type="hidden" name="maMon" value="@ViewBag.SelectedMaMon" />
                    <input type="hidden" name="hocKy" value="@ViewBag.SelectedHocKy" />

                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50px;">STT</th>
                                <th style="width: 120px;">Mã SV</th>
                                <th>Họ và Tên</th>
                                <th style="width: 150px;">Lần Thi</th>
                                <th style="width: 180px;">Điểm (0.0 - 10.0)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>
                                        <strong>@Model[i].MaSv</strong>
                                        <input type="hidden" name="items[@i].MaSv" value="@Model[i].MaSv" />
                                        <input type="hidden" name="items[@i].TenSv" value="@Model[i].TenSv" />
                                    </td>
                                    <td>@Model[i].TenSv</td>
                                    <td>
                                        <input type="number" name="items[@i].LanThi" class="form-control" value="@Model[i].LanThi" min="1" max="5" />
                                    </td>
                                    <td>
                                        <input type="number" step="0.1" min="0" max="10" name="items[@i].Diem" class="form-control fw-bold text-primary" value="@Model[i].Diem" placeholder="Chưa có điểm" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="text-end mt-3">
                        <button type="submit" class="btn btn-success btn-lg px-4">
                            <i class="fas fa-save me-1"></i> Lưu Bảng Điểm
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(ViewBag.SelectedMaLop) && !string.IsNullOrEmpty(ViewBag.SelectedMaMon))
    {
        <div class="alert alert-warning text-center">
            <i class="fas fa-info-circle me-1"></i> Không tìm thấy sinh viên nào thuộc lớp được chọn!
        </div>
    }
</div>
