@using QuanLyDiemDaiHoc.Areas.Admin.Models
@model List<DiemModelItem>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Quản lý và nhập điểm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 py-3">
    <h3 class="fw-bold text-dark mb-4">QUẢN LÝ VÀ NHẬP ĐIỂM SINH VIÊN</h3>

    <!-- Hiển thị thông báo thành công hoặc lỗi -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Form Bộ Lọc (GET) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 p-4 bg-white">
        <form asp-action="Index" method="get">
            <div class="row align-items-end g-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold small text-muted">Chọn Lớp học</label>
                    <select name="maLop" class="form-select rounded-3" asp-items="ViewBag.MaLop" required>
                        <option value="">-- Chọn Lớp --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold small text-muted">Chọn Môn học</label>
                    <select name="maMon" class="form-select rounded-3" asp-items="ViewBag.MaMon" required>
                        <option value="">-- Chọn Môn --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold small text-muted">Học kỳ</label>
                    <input type="number" name="hocKy" class="form-control rounded-3" value="@ViewBag.SelectedHocKy" required />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 rounded-3 shadow-sm py-2">
                        <i class="fas fa-search me-1"></i> Lọc danh sách
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Bảng Nhập Điểm (Chỉ hiển thị khi đã chọn Lớp và Môn) -->
    @if (!string.IsNullOrEmpty(ViewBag.SelectedMaLop as string) && !string.IsNullOrEmpty(ViewBag.SelectedMaMon as string))
    {
        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
            <form asp-action="SaveGrades" method="post">
                @Html.AntiForgeryToken()

                <!-- Truyền ẩn các tham số khóa bộ lọc để Controller nhận diện khi POST -->
                <input type="hidden" name="maLop" value="@ViewBag.SelectedMaLop" />
                <input type="hidden" name="maMon" value="@ViewBag.SelectedMaMon" />
                <input type="hidden" name="hocKy" value="@ViewBag.SelectedHocKy" />

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-uppercase fs-7 text-muted">
                            <tr>
                                <th class="py-3 px-4" style="width: 60px;">STT</th>
                                <th class="py-3">Mã sinh viên</th>
                                <th class="py-3">Họ và tên</th>
                                <th class="py-3 text-center" style="width: 150px;">Điểm số (0-10)</th>
                                <th class="py-3 text-center" style="width: 120px;">Lần thi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                int stt = 1;
                                for (int i = 0; i < Model.Count; i++)
                                {
                                    <tr>
                                        <td class="px-4 text-muted">@(stt++)</td>
                                        <td class="fw-semibold text-secondary">
                                            @Model[i].MaSv
                                            <!-- Hidden inputs để binding đúng danh sách items về Controller -->
                                            <input type="hidden" name="items[@i].MaSv" value="@Model[i].MaSv" />
                                            <input type="hidden" name="items[@i].TenSv" value="@Model[i].TenSv" />
                                        </td>
                                        <td class="fw-bold text-dark">@Model[i].TenSv</td>
                                        <td class="text-center">
                                            <input type="number" step="0.1" min="0" max="10" name="items[@i].Diem" value="@Model[i].Diem" class="form-control text-center rounded-3" placeholder="0 - 10" />
                                        </td>
                                        <td class="text-center">
                                            <input type="number" min="1" max="5" name="items[@i].LanThi" value="@Model[i].LanThi" class="form-control text-center rounded-3" />
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">Không có sinh viên nào thuộc lớp này.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model != null && Model.Any())
                {
                    <div class="p-3 bg-light border-top d-flex justify-content-end">
                        <button type="submit" class="btn btn-success px-4 rounded-3 shadow-sm">
                            <i class="fas fa-save me-2"></i> Lưu bảng điểm
                        </button>
                    </div>
                }
            </form>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var lopSelect = document.querySelector("select[name='maLop']");
            var monSelect = document.querySelector("select[name='maMon']");
            if (lopSelect) lopSelect.value = '@ViewBag.SelectedMaLop';
            if (monSelect) monSelect.value = '@ViewBag.SelectedMaMon';
        });
    </script>
}