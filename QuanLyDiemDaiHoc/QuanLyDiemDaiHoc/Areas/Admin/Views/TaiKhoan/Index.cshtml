@model IEnumerable<QuanLyDiemDaiHoc.Models.TaiKhoan>

@{
    ViewData["Title"] = "Quản lý tài khoản";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-muted small">
                    <li class="breadcrumb-item">PHÒNG ĐÀO TẠO</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-1">Quản lý tài khoản</h2>
            <p class="text-muted small mb-0">Phân quyền và kiểm soát trạng thái truy cập</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary px-3 py-2 shadow-sm d-flex align-items-center rounded-3">
                <i class="fas fa-plus me-2"></i> Thêm tài khoản
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase fs-7 text-muted">
                    <tr>
                        <th class="py-3 px-4">Tên đăng nhập</th>
                        <th class="py-3">Vai trò</th>
                        <th class="py-3">Mã liên kết</th>
                        <th class="py-3">Trạng thái</th>
                        <th class="py-3 text-end px-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4 fw-semibold text-dark">@item.TenDangNhap</td>
                                <td>
                                    @if (item.PhanQuyen == 1)
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">Quản trị viên</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info bg-opacity-10 text-info px-3 py-2 rounded-pill">Sinh viên</span>
                                    }
                                </td>
                                <td class="text-muted">@(item.MaSv ?? "ADMIN")</td>
                                <td>
                                    @if (item.TrangThai)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fw-semibold">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill fw-semibold">Đã khóa</span>
                                    }
                                </td>
                                <td class="text-end px-4">
                                    <a asp-action="ToggleStatus" asp-route-id="@item.TenDangNhap" class="btn btn-sm btn-light text-warning me-1 rounded-2 px-2 py-1" title="Khóa/Mở khóa">
                                        <i class="fas fa-lock fa-xs"></i> Khóa tài khoản
                                    </a>
                                    <a asp-action="ResetPassword" asp-route-id="@item.TenDangNhap" class="btn btn-sm btn-light text-primary rounded-2 px-2 py-1" title="Đặt lại mật khẩu">
                                        <i class="fas fa-key fa-xs"></i> Đặt lại mật khẩu
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">Chưa có dữ liệu tài khoản trong cơ sở dữ liệu.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>