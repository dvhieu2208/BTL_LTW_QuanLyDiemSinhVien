@model IEnumerable<QuanLyDiemDaiHoc.Models.MonHoc>

@{
    ViewData["Title"] = "Quản lý môn học";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-muted small">
                    <li class="breadcrumb-item">PHÒNG ĐÀO TẠO</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-1">Quản lý môn học</h2>
            <p class="text-muted small mb-0">Danh mục học phần trong chương trình đào tạo</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary px-3 py-2 shadow-sm d-flex align-items-center rounded-3">
                <i class="fas fa-plus me-2"></i> Thêm mới
            </a>
        </div>
    </div>

    <form asp-action="Index" method="get" class="card border-0 shadow-sm rounded-4 mb-4 p-3 bg-white">
        <div class="input-group input-group-lg bg-light rounded-3 px-2 border">
            <span class="input-group-text bg-transparent border-0 text-muted">
                <i class="fas fa-search"></i>
            </span>
            <input type="text" name="searchString" value="@Context.Request.Query["searchString"]" class="form-control bg-transparent border-0 shadow-none text-dark" placeholder="Tìm theo mã môn hoặc tên môn...">
        </div>
    </form>

    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase fs-7 text-muted">
                    <tr>
                        <th class="py-3 px-4">Mã môn</th>
                        <th class="py-3">Tên môn học</th>
                        <th class="py-3">Đơn vị học trình (DVHT)</th>
                        <th class="py-3 text-end px-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var initials = !string.IsNullOrEmpty(item.TenMon) 
                                ? string.Concat(item.TenMon.Split(' ').Where(s => s.Length > 0).Take(2).Select(s => s[0])).ToUpper() 
                                : "MH";

                            <tr>
                                <td class="px-4 fw-semibold text-secondary">@item.MaMon</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-3" style="width: 38px; height: 38px; font-size: 14px;">
                                            @initials
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold text-dark">@item.TenMon</h6>
                                            <small class="text-muted">@item.MaMon</small>
                                        </div>
                                    </div>
                                </td>
                                <!-- Sử dụng thuộc tính Dvht đúng với Model đã scaffold -->
                                <td class="fw-semibold text-dark">@item.Dvht</td>
                                <td class="text-end px-4">
                                    <a asp-action="Edit" asp-route-id="@item.MaMon" class="btn btn-sm btn-light text-primary me-1 rounded-2 p-2" title="Sửa">
                                        <i class="fas fa-pen fa-xs"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.MaMon" class="btn btn-sm btn-light text-danger rounded-2 p-2" title="Xóa">
                                        <i class="fas fa-trash fa-xs"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">Chưa có dữ liệu môn học trong cơ sở dữ liệu.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>