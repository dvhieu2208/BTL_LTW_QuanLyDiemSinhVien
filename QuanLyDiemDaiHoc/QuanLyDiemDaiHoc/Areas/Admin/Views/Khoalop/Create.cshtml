@model QuanLyDiemDaiHoc.Models.Lop
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Thêm mới lớp học";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 py-3">
    <h3 class="fw-bold text-dark mb-1">Thêm mới Lớp học</h3>
    <ol class="breadcrumb mb-4 text-muted small">
        <li class="breadcrumb-item"><a asp-action="Index">Quản lý Khoa & Lớp học</a></li>
        <li class="breadcrumb-item active">Thêm mới</li>
    </ol>
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <form asp-action="Create" method="post">
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="MaLop" class="form-label fw-bold">Mã Lớp <span class="text-danger">*</span></label>
                    <input asp-for="MaLop" class="form-control rounded-3" placeholder="Nhập mã lớp" required />
                    <span asp-validation-for="MaLop" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="TenLop" class="form-label fw-bold">Tên Lớp <span class="text-danger">*</span></label>
                    <input asp-for="TenLop" class="form-control rounded-3" placeholder="Nhập tên lớp đầy đủ" required />
                    <span asp-validation-for="TenLop" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="MaKhoa" class="form-label fw-bold">Thuộc Khoa <span class="text-danger">*</span></label>
                    <select asp-for="MaKhoa" class="form-select rounded-3" asp-items="ViewBag.MaKhoa" required>
                        <option value="">-- Chọn khoa quản lý --</option>
                    </select>
                    <span asp-validation-for="MaKhoa" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="KhoaHoc" class="form-label fw-bold">Khóa Học</label>
                    <input asp-for="KhoaHoc" class="form-control rounded-3" placeholder="Nhập khóa học" />
                    <span asp-validation-for="KhoaHoc" class="text-danger"></span>
                </div>
            </div>

            <div class="pt-3 border-top d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-light px-4 rounded-3">Hủy</a>
                <button type="submit" class="btn btn-primary px-4 rounded-3 shadow-sm">Lưu Lớp Học</button>
            </div>
        </form>
    </div>
</div>