@model IEnumerable<QuanLyDiemDaiHoc.Models.Lop>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Quản lý Khoa & Lớp học";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 py-3">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-muted small">
                    <li class="breadcrumb-item">PHÒNG ĐÀO TẠO</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-1">Khoa & lớp học</h2>
            <p class="text-muted small mb-0">Quản lý lớp hành chính và đơn vị đào tạo</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary px-3 py-2 shadow-sm d-flex align-items-center rounded-3">
                <i class="fas fa-plus me-2"></i> Thêm mới
            </a>
        </div>
    </div>
      <!-- Thông báo TempData -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search and Filter Bar -->
    <form asp-action="Index" method="get" class="card border-0 shadow-sm rounded-4 mb-4 p-3 bg-white">
        <div class="row g-3 align-items-center">
            <div class="col-md-9">
                <div class="input-group input-group-lg bg-light rounded-3 px-2 border">
                    <span class="input-group-text bg-transparent border-0 text-muted">
                        <i class="fas fa-search"></i>
                    </span>
                    <input type="text" name="searchString" value="@Context.Request.Query["searchString"]" class="form-control bg-transparent border-0 shadow-none text-dark" placeholder="Tìm theo mã lớp hoặc tên lớp...">
                </div>
            </div>
            <div class="col-md-3">
                <select name="maKhoaFilter" class="form-select form-select-lg bg-light border text-dark rounded-3 shadow-none" onchange="this.form.submit()">
                    <option value="">Tất cả khoa</option>
                    @if (ViewBag.KhoaList != null)
                    {
                        foreach (var khoa in ViewBag.KhoaList)
                        {
                            <option value="@khoa.MaKhoa">@khoa.TenKhoa</option>
                        }
                    }
                </select>
            </div>
        </div>
    </form>

    <!-- Table Section -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase fs-7 text-muted">
                    <tr>
                        <th class="py-3 px-4">Mã lớp</th>
                        <th class="py-3">Tên lớp</th>
                        <th class="py-3">Khoa</th>
                        <th class="py-3">Khóa học</th>
                        <th class="py-3">Sĩ số</th>
                        <th class="py-3 text-end px-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int index = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4 fw-semibold text-secondary">@item.MaLop</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-3" style="width: 38px; height: 38px; font-size: 14px;">
                                            L@(index++)
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold text-dark">@item.TenLop</h6>
                                            <small class="text-muted">@item.MaLop</small>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge bg-light text-dark border px-2 py-1">@(item.MaKhoaNavigation != null ? item.MaKhoaNavigation.TenKhoa : item.MaKhoa)</span></td>
                                <td class="text-muted">@item.KhoaHoc</td>
                                <td class="fw-semibold text-dark">@item.SiSo</td>
                                <td class="text-end px-4">
                                    <a asp-action="Edit" asp-route-id="@item.MaLop" class="btn btn-sm btn-light text-primary me-1 rounded-2 p-2" title="Sửa">
                                        <i class="fas fa-pen fa-xs"></i>
                                    </a>

                                    <!-- Nút kích hoạt Modal Xóa -->
                                    <button type="button" class="btn btn-sm btn-light text-danger rounded-2 p-2" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.MaLop" title="Xóa">
                                        <i class="fas fa-trash fa-xs"></i>
                                    </button>

                                    <!-- Modal Xác nhận xóa -->
                                    <div class="modal fade" id="deleteModal-@item.MaLop" tabindex="-1" aria-labelledby="deleteModalLabel-@item.MaLop" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content text-start">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="deleteModalLabel-@item.MaLop">Xác nhận xóa lớp học</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    Bạn có chắc chắn muốn xóa lớp <strong class="text-danger">@item.TenLop (@item.MaLop)</strong> này không?
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                    <form asp-action="Delete" asp-route-id="@item.MaLop" method="post" class="d-inline">
                                                        <button type="submit" class="btn btn-danger">Xóa</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Chưa có dữ liệu lớp học trong cơ sở dữ liệu.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.querySelector("input[name='searchString']");

            if (searchInput) {
                searchInput.addEventListener("input", function () {
                    const keyword = this.value.toLowerCase().trim();
                    const tableRows = document.querySelectorAll("table tbody tr");

                    tableRows.forEach(row => {
                        // Bỏ qua dòng thông báo "Chưa có dữ liệu"
                        if (row.cells.length <= 1) return;

                        let match = false;
                        // Duyệt qua các ô trong hàng (trừ cột thao tác cuối cùng)
                        for (let i = 0; i < row.cells.length - 1; i++) {
                            if (row.cells[i].textContent.toLowerCase().includes(keyword)) {
                                match = true;
                                break;
                            }
                        }

                        // Hiện hoặc ẩn dòng tùy thuộc vào kết quả khớp từ khóa
                        row.style.display = match ? "" : "none";
                    });
                });
            }
        });
    </script>
}