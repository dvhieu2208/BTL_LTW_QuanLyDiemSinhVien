@model QuanLyDiemDaiHoc.Models.Lop
@{
    ViewData["Title"] = "Chỉnh sửa lớp học";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb ums-breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Danh sách lớp học</a></li>
                <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa thông tin</li>
            </ol>
        </nav>
        <h2 class="page-title">Chỉnh sửa lớp học</h2>
        <p class="page-subtitle">Mã lớp <span class="cell-code">@Model.MaLop</span> không thể thay đổi.</p>
    </div>
</div>

<div class="card">
    <form asp-action="Edit" method="post">
        <div class="form-section">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Khóa chính ẩn để truyền ID -->
            <input type="hidden" asp-for="MaLop" />

            <div class="form-section-title"><i class="fas fa-chalkboard"></i> Thông tin lớp học</div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Mã lớp</label>
                    <input class="form-control" value="@Model.MaLop" disabled />
                </div>
                <div class="col-md-6">
                    <label asp-for="TenLop" class="form-label">Tên lớp <span class="text-danger">*</span></label>
                    <input asp-for="TenLop" class="form-control" required />
                    <span asp-validation-for="TenLop" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="MaKhoa" class="form-label">Thuộc khoa <span class="text-danger">*</span></label>
                    <select asp-for="MaKhoa" class="form-select" asp-items="ViewBag.MaKhoa" required>
                        <option value="">-- Chọn khoa quản lý --</option>
                    </select>
                    <span asp-validation-for="MaKhoa" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="KhoaHoc" class="form-label">Khóa học</label>
                    <input asp-for="KhoaHoc" class="form-control" placeholder="Nhập khóa học (VD: K2026)" />
                    <span asp-validation-for="KhoaHoc" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-light">Hủy</a>
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Lưu thay đổi</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
