@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Tổng quan đào tạo";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h6 class="text-uppercase text-muted fs-8 mb-1">PHÒNG ĐÀO TẠO</h6>
        <h2 class="fw-bold">Tổng quan đào tạo</h2>
        <p class="text-muted" id="namHocText">Năm học Đang cập nhật...</p>
    </div>
    <a asp-area="Admin" asp-controller="Diem" asp-action="Index"
    class="btn btn-primary d-flex align-items-center shadow-sm">
        <i class="fas fa-edit me-2"></i> Nhập điểm nhanh
    </a>
</div>

<!-- Row 1: Thẻ Thống Kê (Stat Cards) -->
<div class="row g-4 mb-4">
    <!-- Tổng sinh viên -->
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card shadow-sm h-100 border-0 rounded-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted fs-8 fw-semibold text-uppercase">Tổng sinh viên</span>
                    <div class="icon-box text-primary fs-5"><i class="fas fa-users"></i></div>
                </div>
                <h2 class="fw-bold mb-1">@ViewBag.TongSinhVien</h2>
                <p class="card-text text-success fs-7 mb-0"><i class="fas fa-arrow-up me-1"></i>+5.2% so với năm trước</p>
            </div>
        </div>
    </div>

    <!-- Tổng số Lớp học -->
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card shadow-sm h-100 border-0 rounded-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted fs-8 fw-semibold text-uppercase">Tổng số Lớp học</span>
                    <div class="icon-box text-warning fs-5"><i class="fas fa-chalkboard"></i></div>
                </div>
                <h2 class="fw-bold mb-1">@ViewBag.TongLop</h2>
                <p class="card-text text-muted fs-7 mb-0">Hoạt động ổn định</p>
            </div>
        </div>
    </div>

    <!-- Tổng số Môn học -->
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card shadow-sm h-100 border-0 rounded-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted fs-8 fw-semibold text-uppercase">Tổng số Môn học</span>
                    <div class="icon-box text-success fs-5"><i class="fas fa-book-open"></i></div>
                </div>
                <h2 class="fw-bold mb-1">@ViewBag.TongMonHoc</h2>
                <p class="card-text text-success fs-7 mb-0">Đã phân bổ học phần</p>
            </div>
        </div>
    </div>

    <!-- Tổng số Khoa -->
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card shadow-sm h-100 border-0 rounded-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted fs-8 fw-semibold text-uppercase">Tổng số Khoa</span>
                    <div class="icon-box text-danger fs-5"><i class="fas fa-building"></i></div>
                </div>
                <h2 class="fw-bold mb-1">@ViewBag.TongKhoa</h2>
                <p class="card-text text-muted fs-7 mb-0">Đơn vị trực thuộc</p>
            </div>
        </div>
    </div>
</div>

<!-- Row 2: Biểu đồ & Sinh viên nổi bật -->
<div class="row g-4 mb-4">
    <!-- Phân bổ kết quả học tập (Biểu đồ cột) -->
    <div class="col-xl-8">
        <div class="card chart-card shadow-sm h-100 border-0 rounded-4">
            <div class="card-header border-0 bg-white pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold m-0">Phân bổ kết quả học tập</h5>
                <span class="text-muted fs-7">GPA hệ 4</span>
            </div>
            <div class="card-body p-4">
                <canvas id="gradeDistributionChart" style="max-height: 280px;"></canvas>
            </div>
        </div>
    </div>

    <!-- Sinh viên nổi bật (Danh sách) -->
    <div class="col-xl-4">
        <div class="card ranking-card shadow-sm h-100 border-0 rounded-4">
            <div class="card-header border-0 bg-white pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold m-0">Sinh viên nổi bật</h5>
                <span class="text-muted fs-7">Top danh sách</span>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush pt-2">
                    @{
                        int index = 1;
                        var listSV = ViewBag.SinhVienNoiBat as List<QuanLyDiemDaiHoc.Models.SinhVien>;
                    }
                    @if (listSV != null && listSV.Count > 0)
                    {
                        foreach (var sv in listSV)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-4 py-3 border-0">
                                <div class="d-flex align-items-center">
                                    <span class="text-muted fw-bold me-3">@(index < 10 ? "0" + index : index.ToString())</span>
                                    <div class="avatar bg-light text-primary fw-bold d-flex align-items-center justify-content-center rounded-3 me-3" style="width: 40px; height: 40px;">
                                        @(sv.TenSv.Length >= 2 ? sv.TenSv.Substring(sv.TenSv.LastIndexOf(' ') + 1).Substring(0, 1) : "SV")
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@sv.TenSv</div>
                                        <div class="fs-8 text-muted">@sv.MaSv • @(sv.MaLopNavigation?.TenLop ?? sv.MaLop)</div>
                                    </div>
                                </div>
                                <span class="fw-bold text-primary fs-6">3.40</span>
                            </li>
                            index++;
                        }
                    }
                    else
                    {
                        <li class="list-group-item text-center text-muted py-4">Chưa có dữ liệu sinh viên</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const d = new Date();
        let year = d.getFullYear();
        // Nếu muốn sang tháng 9 mới đổi năm học thì thêm logic kiểm tra tháng (d.getMonth() >= 8)
        let nextYear = year + 1;

        document.getElementById("namHocText").innerText = "Năm học " + year + "-" + nextYear;
    </script>
    <script>
        // Cấu hình Chart.js hiển thị biểu đồ phân bổ điểm
        const ctx = document.getElementById('gradeDistributionChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['Xuất sắc', 'Giỏi', 'Khá', 'Trung bình', 'Yếu'],
                datasets: [{
                    label: 'Số lượng sinh viên',
                    data: [2, 10, 25, 10, 3], // Bạn có thể thay bằng dữ liệu truyền từ Controller
                    backgroundColor: ['#1cc88a', '#36b9cc', '#4e73df', '#f6c23e', '#e74a3b'],
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true, grid: { borderDash: [2, 2] } },
                    x: { grid: { display: false } }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });
    </script>
}
