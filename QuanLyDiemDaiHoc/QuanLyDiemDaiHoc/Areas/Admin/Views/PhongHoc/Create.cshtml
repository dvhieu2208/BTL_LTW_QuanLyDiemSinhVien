@model QuanLyDiemDaiHoc.Models.PhongHoc
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Thêm mới phòng học";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 py-3">
    <h3 class="fw-bold text-dark mb-1">Thêm mới Phòng học</h3>
    <ol class="breadcrumb mb-4 text-muted small">
        <li class="breadcrumb-item"><a asp-action="Index">Quản lý phòng học</a></li>
        <li class="breadcrumb-item active">Thêm mới</li>
    </ol>

    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <form asp-action="Create" method="post">
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="MaPhong" class="form-label fw-bold">Mã Phòng <span class="text-danger">*</span></label>
                    <input asp-for="MaPhong" class="form-control rounded-3" placeholder="Nhập mã phòng (VD: A101)" required />
                    <span asp-validation-for="MaPhong" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="TenPhong" class="form-label fw-bold">Tên Phòng <span class="text-danger">*</span></label>
                    <input asp-for="TenPhong" class="form-control rounded-3" placeholder="Nhập tên phòng đầy đủ (VD: Phòng A101)" required />
                    <span asp-validation-for="TenPhong" class="text-danger"></span>
                </div>
            </div>

            <div class="pt-3 border-top d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-light px-4 rounded-3">Hủy</a>
                <button type="submit" class="btn btn-primary px-4 rounded-3 shadow-sm">Lưu Phòng Học</button>
            </div>
        </form>
    </div>
</div>