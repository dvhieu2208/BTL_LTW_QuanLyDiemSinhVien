@model QuanLyDiemDaiHoc.Models.PhongHoc
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Chỉnh sửa phòng học";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 py-3">
    <h3 class="fw-bold text-dark mb-1">Quản lý phòng học</h3>
    <ol class="breadcrumb mb-4 text-muted small">
        <li class="breadcrumb-item"><a asp-action="Index">Danh sách phòng học</a></li>
        <li class="breadcrumb-item active">Chỉnh sửa thông tin</li>
    </ol>

    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="MaPhong" />

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Mã Phòng</label>
                    <input class="form-control rounded-3 bg-light" value="@Model.MaPhong" disabled />
                </div>
                <div class="col-md-6">
                    <label asp-for="TenPhong" class="form-label fw-bold">Tên Phòng <span class="text-danger">*</span></label>
                    <input asp-for="TenPhong" class="form-control rounded-3" required />
                    <span asp-validation-for="TenPhong" class="text-danger"></span>
                </div>
            </div>

            <div class="pt-3 border-top d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-light px-4 rounded-3">Hủy</a>
                <button type="submit" class="btn btn-primary px-4 rounded-3 shadow-sm">Lưu Thay Đổi</button>
            </div>
        </form>
    </div>
</div>