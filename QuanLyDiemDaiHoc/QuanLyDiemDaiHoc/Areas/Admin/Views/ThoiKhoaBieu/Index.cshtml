@model IEnumerable<QuanLyDiemDaiHoc.Models.ThoiKhoaBieu>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Thời khóa biểu";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 py-3">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-muted small">
                    <li class="breadcrumb-item">PHÒNG ĐÀO TẠO</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-1">Thời khóa biểu</h2>
            <p class="text-muted small mb-0">Lịch học tuần và phân bổ giảng dạy</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary px-3 py-2 shadow-sm d-flex align-items-center rounded-3">
                <i class="fas fa-plus me-2"></i> Thêm lịch học
            </a>
        </div>
    </div>

    <!-- Thông báo TempData -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search Bar -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 p-3 bg-white">
        <div class="input-group input-group-lg bg-light rounded-3 px-2 border">
            <span class="input-group-text bg-transparent border-0 text-muted">
                <i class="fas fa-search"></i>
            </span>
            <input type="text" id="searchInput" class="form-control bg-transparent border-0 shadow-none text-dark" placeholder="Tìm theo lớp, môn học hoặc phòng học...">
        </div>
    </div>

    <!-- Table Section -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase fs-7 text-muted">
                    <tr>
                        <th class="py-3 px-4">Mã lớp</th>
                        <th class="py-3">Môn học</th>
                        <th class="py-3">Học kỳ</th>
                        <th class="py-3">Thứ học</th>
                        <th class="py-3">Ca học</th>
                        <th class="py-3">Phòng học</th>
                        <th class="py-3 text-end px-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4 fw-semibold text-secondary">@(item.MaLopNavigation != null ? item.MaLopNavigation.TenLop : item.MaLop)</td>
                                <td>
                                    <div>
                                        <h6 class="mb-0 fw-bold text-dark">@(item.MaMonNavigation != null ? item.MaMonNavigation.TenMon : item.MaMon)</h6>
                                        <small class="text-muted">@item.MaMon</small>
                                    </div>
                                </td>
                                <td><span class="badge bg-light text-dark border px-2 py-1">Học kỳ @item.HocKy</span></td>
                                <td class="fw-semibold text-dark">Thứ @item.ThuHoc</td>
                                <td class="text-muted">Ca @item.CaHoc</td>
                                <td>
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 rounded-pill">
                                        @(item.MaPhongNavigation != null ? item.MaPhongNavigation.TenPhong : item.MaPhong)
                                    </span>
                                </td>
                                <td class="text-end px-4">
                                    <!-- Nút Sửa truyền đủ 2 khóa chính: maLop và maMon -->
                                    <a asp-action="Edit" asp-route-maLop="@item.MaLop" asp-route-maMon="@item.MaMon" class="btn btn-sm btn-light text-primary me-1 rounded-2 p-2" title="Sửa">
                                        <i class="fas fa-pen fa-xs"></i>
                                    </a>

                                    <!-- Nút Xóa kích hoạt Modal riêng biệt cho từng dòng -->
                                    <button type="button" class="btn btn-sm btn-light text-danger rounded-2 p-2" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.MaLop-@item.MaMon" title="Xóa">
                                        <i class="fas fa-trash fa-xs"></i>
                                    </button>

                                    <!-- Modal Xác nhận xóa -->
                                    <div class="modal fade" id="deleteModal-@item.MaLop-@item.MaMon" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content text-start">
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Xác nhận xóa lịch học</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    Bạn có chắc chắn muốn xóa lịch học môn <strong class="text-danger">@(item.MaMonNavigation?.TenMon)</strong> của lớp <strong class="text-dark">@(item.MaLopNavigation?.TenLop)</strong> này không?
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                    <!-- Form POST xóa truyền đủ maLop và maMon -->
                                                    <form asp-action="Delete" asp-route-maLop="@item.MaLop" asp-route-maMon="@item.MaMon" method="post" class="d-inline">
                                                        <button type="submit" class="btn btn-danger">Xóa</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Chưa có dữ liệu thời khóa biểu trong hệ thống.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Tính năng tìm kiếm thời gian thực trên giao diện
        document.getElementById('searchInput').addEventListener('input', function () {
            const keyword = this.value.toLowerCase().trim();
            const rows = document.querySelectorAll('table tbody tr');

            rows.forEach(row => {
                if (row.cells.length <= 1) return;
                let match = false;
                for (let i = 0; i < row.cells.length - 1; i++) {
                    if (row.cells[i].textContent.toLowerCase().includes(keyword)) {
                        match = true;
                        break;
                    }
                }
                row.style.display = match ? '' : 'none';
            });
        });
    </script>
}