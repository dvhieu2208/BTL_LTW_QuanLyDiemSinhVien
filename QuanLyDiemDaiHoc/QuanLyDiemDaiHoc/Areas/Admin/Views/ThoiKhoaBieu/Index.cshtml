@model IEnumerable<QuanLyDiemDaiHoc.Models.ThoiKhoaBieu>

@{
    ViewData["Title"] = "Quản lý thời khóa biểu";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-muted small">
                    <li class="breadcrumb-item">PHÒNG ĐÀO TẠO</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-1">Thời khóa biểu</h2>
            <p class="text-muted small mb-0">Lịch học tuần và phân bổ giảng dạy</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary px-3 py-2 shadow-sm d-flex align-items-center rounded-3">
                <i class="fas fa-plus me-2"></i> Thêm lịch học
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase fs-7 text-muted">
                    <tr>
                        <th class="py-3 px-4">Mã lớp</th>
                        <th class="py-3">Môn học</th>
                        <th class="py-3">Học kỳ</th>
                        <th class="py-3">Thứ học</th>
                        <th class="py-3">Ca học</th>
                        <th class="py-3">Phòng học</th>
                        <th class="py-3 text-end px-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-4 fw-semibold text-secondary">
                                    @(item.MaLopNavigation != null ? item.MaLopNavigation.TenLop : item.MaLop)
                                </td>
                                <td>
                                    <h6 class="mb-0 fw-bold text-dark">@(item.MaMonNavigation != null ? item.MaMonNavigation.TenMon : item.MaMon)</h6>
                                    <small class="text-muted">@item.MaMon</small>
                                </td>
                                <td><span class="badge bg-light text-dark border px-2 py-1">Học kỳ @item.HocKy</span></td>
                                <td class="fw-semibold text-dark">Thứ @item.ThuHoc</td>
                                <td class="text-muted">Ca @item.CaHoc</td>
                                <td><span class="badge bg-primary bg-opacity-10 text-primary px-2 py-1">@(item.MaPhongNavigation != null ? item.MaPhongNavigation.TenPhong : item.MaPhong)</span></td>
                                <td class="text-end px-4">
                                    <a asp-action="Edit" asp-route-malop="@item.MaLop" asp-route-mamon="@item.MaMon" class="btn btn-sm btn-light text-primary me-1 rounded-2 p-2" title="Sửa">
                                        <i class="fas fa-pen fa-xs"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-malop="@item.MaLop" asp-route-mamon="@item.MaMon" class="btn btn-sm btn-light text-danger rounded-2 p-2" title="Xóa">
                                        <i class="fas fa-trash fa-xs"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Chưa có dữ liệu thời khóa biểu trong cơ sở dữ liệu.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>