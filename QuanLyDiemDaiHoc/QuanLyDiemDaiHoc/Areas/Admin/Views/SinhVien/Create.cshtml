@model QuanLyDiemDaiHoc.Models.SinhVien
@{
    ViewData["Title"] = "Thêm sinh viên mới";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb ums-breadcrumb">
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="SinhVien" asp-action="Index">Danh sách sinh viên</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thêm mới sinh viên</li>
            </ol>
        </nav>
        <h2 class="page-title">Thêm sinh viên mới</h2>
        <p class="page-subtitle">Tài khoản đăng nhập sẽ được tạo tự động với tên đăng nhập là mã sinh viên.</p>
    </div>
</div>

<div class="card mb-4">
    <form asp-action="Create" method="post">
        <div class="form-section pb-0">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        </div>

        <div class="form-section">
            <div class="form-section-title"><i class="fas fa-id-card"></i> Thông tin cơ bản</div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="MaSv" class="form-label">Mã sinh viên <span class="text-danger">*</span></label>
                    <input asp-for="MaSv" class="form-control" placeholder="Nhập mã sinh viên" required />
                    <span asp-validation-for="MaSv" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="TenSv" class="form-label">Họ và tên <span class="text-danger">*</span></label>
                    <input asp-for="TenSv" class="form-control" placeholder="Nhập họ và tên đầy đủ" required />
                    <span asp-validation-for="TenSv" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NgaySinh" class="form-label">Ngày sinh</label>
                    <input asp-for="NgaySinh" type="date" class="form-control" />
                    <span asp-validation-for="NgaySinh" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="GioiTinh" class="form-label">Giới tính</label>
                    <select asp-for="GioiTinh" class="form-select">
                        <option value="">-- Chọn giới tính --</option>
                        <option value="Nam">Nam</option>
                        <option value="Nữ">Nữ</option>
                    </select>
                    <span asp-validation-for="GioiTinh" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="form-section-title"><i class="fas fa-building-columns"></i> Thông tin đào tạo</div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="MaKhoa" class="form-label">Khoa <span class="text-danger">*</span></label>
                    <select asp-for="MaKhoa" class="form-select" id="ddlKhoa" asp-items="ViewBag.MaKhoa" required>
                        <option value="">-- Chọn khoa --</option>
                    </select>
                    <span asp-validation-for="MaKhoa" class="text-danger"></span>
                    <div class="form-hint">Chọn khoa để tải danh sách lớp và chuyên ngành tương ứng.</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="MaLop" class="form-label">Lớp <span class="text-danger">*</span></label>
                    <select asp-for="MaLop" class="form-select" id="ddlLop" asp-items="ViewBag.MaLop" required>
                        <option value="">-- Chọn lớp --</option>
                    </select>
                    <span asp-validation-for="MaLop" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="MaChuyenNganh" class="form-label">Chuyên ngành</label>
                    <select asp-for="MaChuyenNganh" class="form-select" id="ddlChuyenNganh" asp-items="ViewBag.MaChuyenNganh">
                        <option value="">-- Chọn chuyên ngành --</option>
                    </select>
                    <span asp-validation-for="MaChuyenNganh" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="MaHeDt" class="form-label">Hệ đào tạo</label>
                    <select asp-for="MaHeDt" class="form-select" asp-items="ViewBag.MaHeDt">
                        <option value="">-- Chọn hệ đào tạo --</option>
                    </select>
                    <span asp-validation-for="MaHeDt" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="form-section-title"><i class="fas fa-address-book"></i> Lý lịch</div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="MaQue" class="form-label">Quê quán</label>
                    <select asp-for="MaQue" class="form-select" asp-items="ViewBag.MaQue">
                        <option value="">-- Chọn quê quán --</option>
                    </select>
                    <span asp-validation-for="MaQue" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="MaDanToc" class="form-label">Dân tộc</label>
                    <select asp-for="MaDanToc" class="form-select" asp-items="ViewBag.MaDanToc">
                        <option value="">-- Chọn dân tộc --</option>
                    </select>
                    <span asp-validation-for="MaDanToc" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="MaChucVu" class="form-label">Chức vụ</label>
                    <select asp-for="MaChucVu" class="form-select" asp-items="ViewBag.MaChucVu">
                        <option value="">-- Chọn chức vụ (nếu có) --</option>
                    </select>
                    <span asp-validation-for="MaChucVu" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-light">
                <i class="fas fa-arrow-left"></i> Quay lại
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Lưu sinh viên
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
     <script>
        document.getElementById('ddlKhoa').addEventListener('change', function () {
            var maKhoa = this.value;
            var ddlLop = document.getElementById('ddlLop');
            var ddlChuyenNganh = document.getElementById('ddlChuyenNganh');

            // Reset và khóa lại nếu chưa chọn Khoa
            ddlLop.innerHTML = '<option value="">-- Chọn lớp --</option>';
            ddlChuyenNganh.innerHTML = '<option value="">-- Chọn chuyên ngành --</option>';

            if (!maKhoa) {
                ddlLop.disabled = true;
                ddlChuyenNganh.disabled = true;
                return;
            }

            // Gọi API lấy Lớp theo Khoa
            fetch(`/Admin/SinhVien/GetLopByKhoa?maKhoa=${maKhoa}`)
                .then(response => response.json())
                .then(data => {
                    ddlLop.disabled = false;
                    data.forEach(item => {
                        var option = document.createElement('option');
                        option.value = item.maLop;
                        option.text = item.tenLop;
                        ddlLop.appendChild(option);
                    });
                })
                .catch(error => console.error('Lỗi khi tải lớp:', error));

            // Gọi API lấy Chuyên Ngành theo Khoa
            fetch(`/Admin/SinhVien/GetChuyenNganhByKhoa?maKhoa=${maKhoa}`)
                .then(response => response.json())
                .then(data => {
                    ddlChuyenNganh.disabled = false;
                    data.forEach(item => {
                        var option = document.createElement('option');
                        option.value = item.maChuyenNganh;
                        option.text = item.tenChuyenNganh;
                        ddlChuyenNganh.appendChild(option);
                    });
                })
                .catch(error => console.error('Lỗi khi tải chuyên ngành:', error));
        });
    </script>
}
 