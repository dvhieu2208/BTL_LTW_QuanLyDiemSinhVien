@model IEnumerable<QuanLyDiemDaiHoc.Models.ThoiKhoaBieu>

@{
    ViewData["Title"] = "Thời khóa biểu cá nhân";
    Layout = "~/Areas/Student/Views/Shared/_StudentLayout.cshtml";

    var ds = Model?.ToList() ?? new List<QuanLyDiemDaiHoc.Models.ThoiKhoaBieu>();
    // Lưới tuần: Thứ 2 .. Thứ 7 và Chủ nhật (giá trị 8) — chỉ là cách trình bày dữ liệu sẵn có
    int[] cacThu = { 2, 3, 4, 5, 6, 7, 8 };
    var cacCa = ds.Where(t => t.CaHoc.HasValue).Select(t => t.CaHoc!.Value).Distinct().OrderBy(c => c).ToList();
    bool coNgoaiLuoi = ds.Any(t => !t.ThuHoc.HasValue || !t.CaHoc.HasValue || t.ThuHoc < 2 || t.ThuHoc > 8);
    var mauMon = ds.Select(t => t.MaMon).Distinct().Select((m, i) => new { m, i }).ToDictionary(x => x.m, x => (x.i % 5) + 1);
    int tongDvht = ds.Select(t => new { t.MaMon, Dvht = t.MaMonNavigation?.Dvht ?? 0 }).Distinct().Sum(x => x.Dvht);
}

<div class="page-header">
    <div>
        <div class="page-eyebrow"><i class="fas fa-calendar-alt"></i> Cổng sinh viên</div>
        <h2 class="page-title">Thời khóa biểu</h2>
        <p class="page-subtitle">Lịch học tuần theo lớp sinh viên</p>
    </div>
    @if (ds.Any())
    {
        <div class="seg" role="tablist" aria-label="Chế độ hiển thị">
            <button type="button" class="btn btn-sm active" data-view="grid" role="tab" aria-selected="true"><i class="fas fa-table-cells"></i> Dạng lưới</button>
            <button type="button" class="btn btn-sm" data-view="list" role="tab" aria-selected="false"><i class="fas fa-list"></i> Danh sách</button>
        </div>
    }
</div>

<!-- Thẻ thông tin lớp -->
<div class="row g-3 mb-4 stagger">
    <div class="col-md-6 col-xl-4">
        <div class="card stat-card">
            <div class="stat-top">
                <div>
                    <span class="stat-label">Lớp học hành chính</span>
                    <div class="fw-800 fs-5 mt-2">@(ViewBag.TenLop ?? "Chưa xếp lớp")</div>
                </div>
                <span class="stat-icon tone-primary"><i class="fas fa-chalkboard-user"></i></span>
            </div>
            <div class="stat-foot mt-2"><span class="badge badge-soft-success badge-soft"><i class="fas fa-check-circle"></i> Học kỳ hiện tại</span></div>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-4">
        <div class="card stat-card">
            <div class="stat-top"><span class="stat-label">Buổi học / tuần</span><span class="stat-icon tone-violet"><i class="fas fa-calendar-week"></i></span></div>
            <div class="stat-value" data-countup="@ds.Count">@ds.Count</div>
        </div>
    </div>
    <div class="col-6 col-md-3 col-xl-4">
        <div class="card stat-card">
            <div class="stat-top"><span class="stat-label">Tổng ĐVHT</span><span class="stat-icon tone-success"><i class="fas fa-layer-group"></i></span></div>
            <div class="stat-value" data-countup="@tongDvht">@tongDvht</div>
        </div>
    </div>
</div>

@if (ds.Any() && cacCa.Any())
{
    <div class="card table-card mb-4" id="viewGrid">
        <div class="card-head">
            <h5><span class="head-icon"><i class="fas fa-table-cells"></i></span>Lịch học theo tuần</h5>
            @if (coNgoaiLuoi)
            {
                <span class="card-hint"><i class="fas fa-circle-info"></i> Một số buổi chưa có thứ/ca hợp lệ — xem ở chế độ Danh sách.</span>
            }
        </div>
        <div class="table-responsive">
            <table class="table timetable mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:90px">Ca</th>
                        @foreach (var thu in cacThu)
                        {
                            <th>@(thu == 8 ? "Chủ nhật" : "Thứ " + thu)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ca in cacCa)
                    {
                        <tr>
                            <td class="slot-label">Ca @ca</td>
                            @foreach (var thu in cacThu)
                            {
                                var buoi = ds.Where(t => t.CaHoc == ca && t.ThuHoc == thu).ToList();
                                <td>
                                    @foreach (var b in buoi)
                                    {
                                        <div class="tt-class tone-@mauMon[b.MaMon]">
                                            <div class="tt-name">@(b.MaMonNavigation?.TenMon ?? b.MaMon)</div>
                                            <div class="tt-room"><i class="fas fa-door-open"></i> @(b.MaPhongNavigation?.TenPhong ?? b.MaPhong)</div>
                                        </div>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Bảng lịch học -->
<div class="card table-card @(ds.Any() && cacCa.Any() ? "d-none" : "")" id="viewList">
    <div class="card-head">
        <h5><span class="head-icon"><i class="fas fa-list"></i></span>Danh sách môn học theo tuần</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="px-4">Mã môn</th>
                    <th>Môn học</th>
                    <th>Thứ học</th>
                    <th>Ca học</th>
                    <th>Phòng học</th>
                    <th class="text-center">Học kỳ</th>
                </tr>
            </thead>
            <tbody>
                @if (ds.Any())
                {
                    foreach (var item in ds.OrderBy(t => t.ThuHoc).ThenBy(t => t.CaHoc))
                    {
                        <tr>
                            <td class="px-4"><span class="cell-code">@item.MaMon</span></td>
                            <td>
                                <div class="cell-title">@(item.MaMonNavigation?.TenMon ?? item.MaMon)</div>
                                <div class="cell-sub">ĐVHT: @(item.MaMonNavigation?.Dvht ?? 0)</div>
                            </td>
                            <td><span class="badge badge-soft-primary">Thứ @item.ThuHoc</span></td>
                            <td class="fw-semibold">Ca @item.CaHoc</td>
                            <td>
                                <span class="badge badge-outline badge-soft">
                                    <i class="fas fa-door-open text-primary"></i> @(item.MaPhongNavigation?.TenPhong ?? item.MaPhong)
                                </span>
                            </td>
                            <td class="text-center"><span class="badge badge-soft-secondary">Học kỳ @item.HocKy</span></td>
                        </tr>
                    }
                }
                else
                {
                    <tr class="empty-row">
                        <td colspan="6">
                            <div class="empty-state">
                                <div class="empty-icon"><i class="fas fa-calendar-times"></i></div>
                                <div class="empty-title">Chưa có lịch học</div>
                                @if (ViewBag.ThongBao != null)
                                {
                                    <p>@ViewBag.ThongBao</p>
                                }
                                else
                                {
                                    <p>Chưa có thời khóa biểu cho lớp học này.</p>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var grid = document.getElementById('viewGrid');
            var list = document.getElementById('viewList');
            var buttons = document.querySelectorAll('[data-view]');
            if (!grid || !list || !buttons.length) { return; }
            function show(mode) {
                grid.classList.toggle('d-none', mode !== 'grid');
                list.classList.toggle('d-none', mode !== 'list');
                buttons.forEach(function (b) {
                    var on = b.getAttribute('data-view') === mode;
                    b.classList.toggle('active', on);
                    b.setAttribute('aria-selected', String(on));
                });
                try { localStorage.setItem('ums-tkb-view', mode); } catch (e) { }
            }
            buttons.forEach(function (b) { b.addEventListener('click', function () { show(b.getAttribute('data-view')); }); });
            var saved = null;
            try { saved = localStorage.getItem('ums-tkb-view'); } catch (e) { }
            if (saved === 'list' || saved === 'grid') { show(saved); }
        })();
    </script>
}
