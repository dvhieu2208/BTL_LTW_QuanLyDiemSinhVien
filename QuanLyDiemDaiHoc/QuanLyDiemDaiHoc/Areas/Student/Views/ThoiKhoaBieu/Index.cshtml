@model IEnumerable<QuanLyDiemDaiHoc.Models.ThoiKhoaBieu>

@{
    ViewData["Title"] = "Thời khóa biểu cá nhân";
    Layout = "~/Areas/Student/Views/Shared/_StudentLayout.cshtml";
}

<div class="container-fluid px-4 py-3">
    <!-- Header trang -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-muted small">
                    <li class="breadcrumb-item">CỔNG SINH VIÊN</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-1">Thời khóa biểu</h2>
            <p class="text-muted small mb-0">Lịch học tuần theo lớp sinh viên</p>
        </div>
    </div>

    <!-- Thông báo / Thẻ thông tin lớp -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 me-3">
                        <i class="fas fa-chalkboard-teacher fa-lg"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-semibold">LỚP HỌC HÀNH CHÍNH</span>
                        <h5 class="fw-bold text-dark mb-0">@(ViewBag.TenLop ?? "Chưa xếp lớp")</h5>
                    </div>
                </div>
                <div>
                    <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fw-semibold">
                        <i class="fas fa-check-circle me-1"></i> Học kỳ hiện tại
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng lịch học -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
            <h5 class="fw-bold text-dark mb-0">
                <i class="fas fa-calendar-alt text-primary me-2"></i> Danh sách môn học theo tuần
            </h5>
        </div>
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7 text-muted">
                        <tr>
                            <th class="py-3 px-4">Mã môn</th>
                            <th class="py-3">Môn học</th>
                            <th class="py-3">Thứ học</th>
                            <th class="py-3">Ca học</th>
                            <th class="py-3">Phòng học</th>
                            <th class="py-3 text-center">Học kỳ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="px-4 fw-semibold text-secondary">@item.MaMon</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-3" style="width: 36px; height: 36px; font-size: 13px;">
                                                MH
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-bold text-dark">@(item.MaMonNavigation?.TenMon ?? item.MaMon)</h6>
                                                <small class="text-muted">ĐVHT: @(item.MaMonNavigation?.Dvht ?? 0)</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-semibold">
                                            Thứ @item.ThuHoc
                                        </span>
                                    </td>
                                    <td class="fw-semibold text-dark">Ca @item.CaHoc</td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-3 py-2 rounded-3 fw-semibold">
                                            <i class="fas fa-door-open text-primary me-1"></i> @(item.MaPhongNavigation?.TenPhong ?? item.MaPhong)
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary px-2 py-1">
                                            Học kỳ @item.HocKy
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fas fa-calendar-times fa-2x mb-3 text-muted opacity-50 d-block"></i>
                                    @if (ViewBag.ThongBao != null)
                                    {
                                        <span>@ViewBag.ThongBao</span>
                                    }
                                    else
                                    {
                                        <span>Chưa có thời khóa biểu cho lớp học này.</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>