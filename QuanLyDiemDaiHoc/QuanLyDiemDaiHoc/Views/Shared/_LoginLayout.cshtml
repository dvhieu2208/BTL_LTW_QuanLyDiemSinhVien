<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#1E3A8A" />
    <title>@ViewData["Title"] - University Portal</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" referrerpolicy="no-referrer" />

    <link rel="stylesheet" href="~/css/ums-core.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login-style.css" asp-append-version="true" />
</head>

<body class="ums login-body">

    <div class="login-bg" aria-hidden="true">
        <span class="blob blob-1"></span>
        <span class="blob blob-2"></span>
        <span class="grid-dots"></span>
    </div>

    <div class="login-container">

        <!-- Phần giới thiệu bên trái -->
        <div class="login-banner">
            <div class="banner-shapes" aria-hidden="true">
                <span class="shape shape-ring"></span>
                <span class="shape shape-circle"></span>
                <span class="shape shape-square"></span>
                <span class="shape shape-dot"></span>
            </div>

            <div class="brand">
                <div class="brand-icon">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                <div>
                    <h5>UNIVERSITY</h5>
                    <small>Hệ thống quản lý điểm</small>
                </div>
            </div>

            <div class="banner-content">
                <h1>Chào mừng<br />bạn trở lại!</h1>

                <p>
                    Hệ thống quản lý điểm sinh viên đại học.
                    Theo dõi kết quả học tập, tra cứu điểm số
                    và quản lý thông tin học tập một cách dễ dàng.
                </p>

                <ul class="banner-features">
                    <li><span><i class="bi bi-bar-chart-line"></i></span>Tra cứu bảng điểm &amp; kết quả học tập</li>
                    <li><span><i class="bi bi-journal-check"></i></span>Đăng ký học phần theo đợt</li>
                    <li><span><i class="bi bi-calendar3"></i></span>Thời khóa biểu theo lớp</li>
                </ul>
            </div>

            <div class="banner-footer">
                LEARN • CONNECT • GROW
            </div>
        </div>

        <div class="login-content">
            @RenderBody()
        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/ums-core.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
